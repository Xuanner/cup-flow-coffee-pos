# Local-only defaults. Do not commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/cup_flow
DB_USERNAME=cup_flow
DB_PASSWORD=cup_flow_local
SERVER_PORT=8080

# Optional account bootstrap. Leave disabled and secrets empty unless a deployment explicitly provisions accounts.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_CASHIER_USERNAME=
AUTH_BOOTSTRAP_CASHIER_PASSWORD=
AUTH_BOOTSTRAP_CASHIER_DISPLAY_NAME=
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=
